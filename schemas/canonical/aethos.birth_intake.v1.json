{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aethos.app/schemas/canonical/aethos.birth_intake.v1.json",
  "title": "Aethos Birth Intake (v1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["subject_id", "birth_date", "birth_location", "consent"],
  "properties": {
    "subject_id": { "type": "string", "minLength": 1 },
    "display_name": { "type": ["string", "null"] },
    "birth_date": { "type": "string", "format": "date" },
    "birth_time": { "type": ["string", "null"], "pattern": "^([01]\\d|2[0-3]):[0-5]\\d(:[0-5]\\d)?$" },
    "birth_time_confidence": { "type": "string", "enum": ["exact", "approximate", "unknown"], "default": "unknown" },
    "birth_location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "properties": {
        "label": { "type": "string" },
        "latitude": { "type": ["number", "null"], "minimum": -90, "maximum": 90 },
        "longitude": { "type": ["number", "null"], "minimum": -180, "maximum": 180 },
        "iana_timezone": { "type": ["string", "null"] },
        "geocoding_source": { "type": ["string", "null"] }
      }
    },
    "current_location": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string" },
        "latitude": { "type": ["number", "null"], "minimum": -90, "maximum": 90 },
        "longitude": { "type": ["number", "null"], "minimum": -180, "maximum": 180 },
        "iana_timezone": { "type": ["string", "null"] }
      }
    },
    "intent": { "type": ["string", "null"], "maxLength": 1000 },
    "systems_requested": {
      "type": "array",
      "items": { "type": "string", "enum": ["western", "vedic", "bazi", "human_design", "numerology", "i_ching", "psychometrics"] },
      "uniqueItems": true,
      "default": ["western"]
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terms", "privacy", "reflective_not_deterministic"],
      "properties": {
        "terms": { "type": "boolean" },
        "privacy": { "type": "boolean" },
        "reflective_not_deterministic": { "type": "boolean" },
        "journal_calibration": { "type": "boolean", "default": false },
        "practitioner_sharing": { "type": "boolean", "default": false }
      }
    },
    "schema_version": { "type": "string", "const": "1.0.0" }
  }
}
