{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aethos.app/schemas/canonical/aethos.timing_event.v1.json",
  "title": "Aethos Timing Event (v1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "subject_id", "system", "event_type", "domain", "title", "start_date", "peak_date", "end_date", "intensity", "confidence", "drivers"],
  "properties": {
    "event_id": { "type": "string", "minLength": 1 },
    "subject_id": { "type": "string", "minLength": 1 },
    "system": { "type": "string", "enum": ["western", "vedic", "bazi", "human_design", "numerology", "i_ching", "psychometrics", "cross_system"] },
    "event_type": { "type": "string", "enum": ["transit", "progression", "solar_return", "lunar_return", "dasha", "luck_cycle", "personal_year", "journal_correlation", "manual"] },
    "domain": { "type": "string", "enum": ["identity", "career", "relationships", "health_adjacent", "creative_work", "money", "home", "shadow_work", "spiritual_practice", "decision", "general"] },
    "title": { "type": "string" },
    "summary": { "type": ["string", "null"] },
    "start_date": { "type": "string", "format": "date" },
    "peak_date": { "type": "string", "format": "date" },
    "end_date": { "type": "string", "format": "date" },
    "intensity": { "type": "number", "minimum": 0, "maximum": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "drivers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "weight"],
        "properties": {
          "label": { "type": "string" },
          "source": { "type": ["string", "null"] },
          "weight": { "type": "number", "minimum": 0, "maximum": 1 },
          "notes": { "type": ["string", "null"] }
        }
      }
    },
    "reflection_prompts": { "type": "array", "items": { "type": "string" } },
    "non_deterministic_notice": { "type": "string", "default": "This timing event is a reflective planning window, not a prediction or guarantee." },
    "methodology_version": { "type": "string", "default": "aethos-methodology-v1" },
    "schema_version": { "type": "string", "const": "1.0.0" }
  }
}
