{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aethos.app/schemas/canonical/aethos.report_module.v1.json",
  "title": "Aethos Report Module (v1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["module_id", "subject_id", "report_type", "title", "sections", "generated_at", "methodology_version"],
  "properties": {
    "module_id": { "type": "string", "minLength": 1 },
    "subject_id": { "type": "string", "minLength": 1 },
    "report_type": { "type": "string", "enum": ["free_profile", "deep_natal_dossier", "year_ahead_timing", "career_timing", "relationship", "practitioner_brief", "enterprise_summary", "academy_workshop"] },
    "title": { "type": "string" },
    "executive_summary": { "type": ["string", "null"] },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["section_id", "heading", "content"],
        "properties": {
          "section_id": { "type": "string" },
          "heading": { "type": "string" },
          "content": { "type": "string" },
          "insight_ids": { "type": "array", "items": { "type": "string" } },
          "timing_event_ids": { "type": "array", "items": { "type": "string" } },
          "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
        }
      }
    },
    "source_manifest": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "label", "source_type"],
        "properties": {
          "source_id": { "type": "string" },
          "label": { "type": "string" },
          "source_type": { "type": "string", "enum": ["calculation", "interpretation_block", "retrieved_context", "journal_signal", "methodology", "manual_note"] }
        }
      }
    },
    "disclaimer": { "type": "string", "default": "Aethos reports are reflective symbolic-intelligence outputs. They are not medical, legal, financial, employment, or deterministic predictive advice." },
    "generated_at": { "type": "string", "format": "date-time" },
    "methodology_version": { "type": "string" },
    "schema_version": { "type": "string", "const": "1.0.0" }
  }
}
