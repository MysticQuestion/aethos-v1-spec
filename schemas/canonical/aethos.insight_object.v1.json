{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aethos.app/schemas/canonical/aethos.insight_object.v1.json",
  "title": "Aethos Insight Object (v1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["insight_id", "subject_id", "domain", "title", "body", "sources", "confidence", "tone"],
  "properties": {
    "insight_id": { "type": "string", "minLength": 1 },
    "subject_id": { "type": "string", "minLength": 1 },
    "domain": { "type": "string", "enum": ["identity", "career", "relationships", "timing", "creative_work", "spiritual_practice", "shadow_work", "decision", "general"] },
    "title": { "type": "string" },
    "body": { "type": "string" },
    "summary": { "type": ["string", "null"] },
    "systems_reconciled": {
      "type": "array",
      "items": { "type": "string", "enum": ["western", "vedic", "bazi", "human_design", "numerology", "i_ching", "psychometrics", "journal"] },
      "uniqueItems": true
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "label", "source_type"],
        "properties": {
          "source_id": { "type": "string" },
          "label": { "type": "string" },
          "source_type": { "type": "string", "enum": ["calculation", "interpretation_block", "journal_signal", "manual_note", "retrieved_context", "methodology"] },
          "weight": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
        }
      }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "tone": { "type": "string", "enum": ["concise", "warm", "scholarly", "practitioner", "executive", "journal_prompt"] },
    "action_prompts": { "type": "array", "items": { "type": "string" } },
    "cautions": { "type": "array", "items": { "type": "string" } },
    "schema_version": { "type": "string", "const": "1.0.0" }
  }
}
